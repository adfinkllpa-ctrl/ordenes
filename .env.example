DASHBOARD_USER=admin
DASHBOARD_PASSWORD=tu_contraseña
SESSION_SECRET=clave_secreta_larga_de_32_caracteres_minimo
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ── Módulo de Órdenes de Compra (app/ordenes) ──────────────────────────────
# URL pública de la app (sin slash final) — se usa para armar los links de
# aprobación en los correos y el redirect_uri de OAuth.
APP_URL=https://tu-dominio.vercel.app

# OAuth 2.0 Client ID (tipo "Web application") creado en el mismo proyecto de
# Google Cloud que la cuenta de servicio. Ver INSTRUCCIONES.md.
GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=xxxx

# Clave para cifrar los refresh tokens de Gmail antes de guardarlos en el Sheet.
# Genera algo largo y aleatorio (ej: openssl rand -hex 32) y no la cambies
# después de tener personas conectadas (perderías acceso a sus tokens guardados).
TOKEN_ENCRYPTION_KEY=clave_larga_y_aleatoria_no_la_pierdas

# Clave para firmar los links de Aprobar/Rechazar de las órdenes.
APPROVAL_TOKEN_SECRET=otra_clave_larga_y_aleatoria
